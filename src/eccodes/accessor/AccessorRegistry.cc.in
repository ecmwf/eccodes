// Generated by CMake from accessor/AccessorRegistry.cc.in using the list of accessor
// source files in src/eccodes/CMakeLists.txt. Do not edit.
//
// Accessors are created by name, so no other code refers to the accessor classes.
// If each accessor registered itself through a global object in its own source file,
// a static libeccodes would lose most of them: the linker only extracts the object
// files that something refers to, and the registration would never run.
// This file is the only place where accessors are registered. It refers to every
// accessor class explicitly, which also forces the linker to keep all of them.

#include "accessor/Accessor.h"

@eccodes_accessor_includes@
namespace eccodes
{

template <>
CodesFactory<Accessor>::CodesFactory()
{
@eccodes_accessor_registrations@}

}  // namespace eccodes

# WMO Lead Centre for Global Climate Re-Analyses (LC-GCR)
if (!defined(class)) {
  constant marsClass = 'lr';
}

alias mars.class  = marsClass;
alias mars.stream = marsStream;
alias mars.type   = marsType;
alias mars.param = paramId;
alias mars.expver = marsExpver;
alias mars.origin = centre;


concept modelName(unknown, "modelNameConcept.def", conceptsDir2, conceptsLocalDirAll): no_copy, dump;
if (modelName isnot "unknown") {
    concept modelVersion(unknown, "modelVersionConcept.[modelName].def", conceptsDir2, conceptsLocalDirAll): no_copy, dump, read_only;
    alias ls.model = modelName;
    alias mars.model = modelName;
}

alias parameter=paramId;
alias parameter.paramId=paramId;
alias parameter.shortName=shortName;
alias parameter.units=units;
alias parameter.name=name;

unalias mars.domain;

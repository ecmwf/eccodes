# Daily climatology: MARS date is "mon-dd" (e.g. mar-01), as in GRIB1.
# g1date returns "mon-dd" when its year argument is 255 and still accepts
# YYYYMMDD on set. The century/year arguments are transient helpers; the
# "when" block copies a newly set year into the real GRIB2 year key.
if ( edition == 2 ){
 unalias mars.date;
 transient daclCentury = 0 : hidden;
 transient daclYearOfCentury = 255 : hidden;
 meta datestr g1date(daclCentury,daclYearOfCentury,month,day);
 alias mars.date=datestr;
 when (daclYearOfCentury != 255) {
   set year = (daclCentury - 1) * 100 + daclYearOfCentury;
   set daclYearOfCentury = 255;
 }
}

#!/usr/bin/env python3
"""Query parameter concepts from ecCodes definitions.

This tool scans definitions under grib1 and grib2, parses paramId/shortName/name/units
concept files, and joins records using identical matching conditions.
"""

from __future__ import annotations

import argparse
import difflib
import fnmatch
import os
import re
import shutil
import subprocess
import sys
import tempfile
from collections import defaultdict
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any, Dict, Iterable, List, Set, Tuple

try:
    import regex as pcre_regex
except ImportError:
    pcre_regex = None

CONCEPTS = {"paramId", "shortName", "name", "units"}
DEFINITION_FILE_RE = re.compile(r'"([^"\\]+\.(?:def|table|tmpl|list|txt))"')
DEFAULT_DEFINITION_PATH_RE = re.compile(r"definition files path is used:\s*(\S+)", re.IGNORECASE)
VALID_COLUMNS = (
    "edition",
    "is_mtg2_switch",
    "scope",
    "paramId",
    "shortName",
    "name",
    "units",
    "encoding",
    "sources",
)

ENTRY_RE = re.compile(r"^'((?:\\'|[^'])*)'\s*=\s*\{\s*$")
ATTR_RE = re.compile(r"^([A-Za-z0-9_]+)\s*=\s*(.*?)\s*;\s*$")

# Build set of concept filenames to match: paramId.def, shortName.def, etc., with variants
CONCEPT_FILENAMES = set()
for concept in CONCEPTS:
    CONCEPT_FILENAMES.add(f"{concept}.def")
    CONCEPT_FILENAMES.add(f"{concept}.lte33.def")
    CONCEPT_FILENAMES.add(f"{concept}.chemsplit.def")

# Cache scan results by definitions_root to avoid re-parsing
_scan_cache: Dict[str, Dict[str, Any]] = {}


@dataclass(frozen=True)
class RecordKey:
    edition: int
    switch: int | None
    scope: str
    attrs: Tuple[Tuple[str, str], ...]


@dataclass
class Record:
    edition: int
    switch: int | None
    scope: str
    attrs: Dict[str, str]
    values: Dict[str, List[str]] = field(default_factory=lambda: defaultdict(list))
    sources: List[str] = field(default_factory=list)


@dataclass(frozen=True)
class FieldMatcher:
    wildcard: str | None = None
    regex_text: str | None = None
    regex_compiled: Any = None


def infer_switch(filename: str) -> int | None:
    if filename.endswith(".lte33.def"):
        return 0
    if filename.endswith(".chemsplit.def"):
        return 2
    if filename.endswith(".def") and not filename.endswith(".legacy.def"):
        return 1
    return None


def infer_concept(filename: str) -> str | None:
    base = filename.split(".", 1)[0]
    return base if base in CONCEPTS else None


def unquote(value: str) -> str:
    value = value.strip()
    if len(value) >= 2 and value[0] == "'" and value[-1] == "'":
        return value[1:-1].replace("\\'", "'")
    return value


def parse_def_file(path: Path) -> Iterable[Tuple[str, Dict[str, str]]]:
    current_value = None
    current_attrs: Dict[str, str] = {}

    with path.open("r", encoding="utf-8") as handle:
        for raw_line in handle:
            line = raw_line.strip()
            if not line or line.startswith("#"):
                continue

            if current_value is None:
                m = ENTRY_RE.match(line)
                if m:
                    current_value = m.group(1).replace("\\'", "'")
                    current_attrs = {}
                continue

            if line.startswith("}"):
                yield current_value, current_attrs
                current_value = None
                current_attrs = {}
                continue

            m_attr = ATTR_RE.match(line)
            if m_attr:
                current_attrs[m_attr.group(1)] = unquote(m_attr.group(2))


def make_record_key(edition: int, switch: int | None, scope: str, attrs: Dict[str, str]) -> RecordKey:
    return RecordKey(
        edition=edition,
        switch=switch,
        scope=scope,
        attrs=tuple(sorted(attrs.items())),
    )


def scan_definitions(definitions_root: Path) -> Dict[RecordKey, Record]:
    # Check cache first to avoid re-parsing the same root
    cache_key = str(definitions_root.resolve())
    if cache_key in _scan_cache:
        cached = _scan_cache[cache_key]
        return dict(cached["records"])

    records: Dict[RecordKey, Record] = {}
    root_str = str(definitions_root)

    for edition_dirname in ("grib1", "grib2"):
        edition_dir = definitions_root / edition_dirname
        if not edition_dir.is_dir():
            continue

        edition = 1 if edition_dirname == "grib1" else 2
        edition_dir_str = os.path.join(root_str, edition_dirname)

        for root, _, files in os.walk(edition_dir_str):
            # Calculate relative path to scope once per directory
            rel_from_root = os.path.relpath(root, edition_dir_str)
            if rel_from_root == ".":
                scope = edition_dirname
            else:
                scope = (edition_dirname + "/" + rel_from_root).replace(os.sep, "/")

            for filename in files:
                # Fast reject: only process concept filenames
                if filename not in CONCEPT_FILENAMES:
                    continue

                concept = infer_concept(filename)
                if concept is None:
                    continue

                switch = infer_switch(filename)
                if edition == 1:
                    switch = None
                elif switch is None:
                    continue

                file_path_str = os.path.join(root, filename)
                rel_source = (scope + "/" + filename).replace("\\", "/")

                for value, attrs in parse_def_file(Path(file_path_str)):
                    key = make_record_key(edition, switch, scope, attrs)
                    if key not in records:
                        records[key] = Record(
                            edition=edition,
                            switch=switch,
                            scope=scope,
                            attrs=dict(attrs),
                        )

                    rec = records[key]
                    if value not in rec.values[concept]:
                        rec.values[concept].append(value)
                    if rel_source not in rec.sources:
                        rec.sources.append(rel_source)

    # Cache the results
    _scan_cache[cache_key] = {"records": records}
    return records


def merge_records(target: Dict[RecordKey, Record], source: Dict[RecordKey, Record]) -> None:
    for key, src in source.items():
        if key not in target:
            target[key] = Record(
                edition=src.edition,
                switch=src.switch,
                scope=src.scope,
                attrs=dict(src.attrs),
            )
        dst = target[key]
        for concept, values in src.values.items():
            for value in values:
                if value not in dst.values[concept]:
                    dst.values[concept].append(value)
        for item in src.sources:
            if item not in dst.sources:
                dst.sources.append(item)


def split_paths(value: str) -> List[str]:
    return [item.strip() for item in value.split(os.pathsep) if item.strip()]


def uniq(values: Iterable[str]) -> List[str]:
    result: List[str] = []
    seen: Set[str] = set()
    for value in values:
        if value not in seen:
            seen.add(value)
            result.append(value)
    return result


def script_default_roots() -> List[str]:
    script_dir = Path(__file__).resolve().parent
    prefix = script_dir.parent

    # Support both source-tree and installed layouts.
    candidates = [
        prefix / "share" / "eccodes" / "definitions",
        prefix / "definitions",
        prefix / "share" / "definitions",
        prefix.parent / "share" / "eccodes" / "definitions",
        Path("definitions"),
    ]
    return uniq(str(p) for p in candidates)


def explicit_roots_from_args_env(args: argparse.Namespace) -> List[str]:
    if args.definitions_root:
        return split_paths(args.definitions_root)

    roots: List[str] = []

    if os.getenv("ECCODES_EXTRA_DEFINITION_PATH"):
        roots.extend(split_paths(os.getenv("ECCODES_EXTRA_DEFINITION_PATH", "")))
    if os.getenv("ECCODES_EXTRA_DEFINITIONS"):
        roots.extend(split_paths(os.getenv("ECCODES_EXTRA_DEFINITIONS", "")))
    if os.getenv("ECCODES_EXTRA_DEFINITONS"):
        roots.extend(split_paths(os.getenv("ECCODES_EXTRA_DEFINITONS", "")))
    if os.getenv("ECCODES_DEFINITION_PATH"):
        roots.extend(split_paths(os.getenv("ECCODES_DEFINITION_PATH", "")))

    return uniq(roots)


def candidate_roots(args: argparse.Namespace) -> List[str]:
    explicit = explicit_roots_from_args_env(args)
    if explicit:
        return explicit
    return script_default_roots()


def resolve_roots(args: argparse.Namespace) -> Tuple[List[Path], List[str], List[str]]:
    filesystem_roots: List[Path] = []
    memfs_roots: List[str] = []
    warnings: List[str] = []
    explicit_roots = set(explicit_roots_from_args_env(args))

    for root in candidate_roots(args):
        if root.startswith("/MEMFS"):
            memfs_roots.append(root)
            continue
        p = Path(root)
        if p.is_dir():
            filesystem_roots.append(p)
        else:
            if root in explicit_roots:
                warnings.append(f"Ignoring non-directory definitions root: {root}")

    return filesystem_roots, uniq(memfs_roots), warnings


def locate_codes_export_resource() -> str | None:
    env_bin = os.getenv("ECCODES_EXPORT_RESOURCE")
    if env_bin and Path(env_bin).is_file():
        return env_bin

    # Prefer the exporter from the same installation as codes_info so MEMFS
    # resources are resolved by a consistent runtime.
    codes_info = locate_codes_info()
    if codes_info:
        sibling = Path(codes_info).resolve().parent / "codes_export_resource"
        if sibling.is_file() and os.access(sibling, os.X_OK):
            return str(sibling)

    path_bin = shutil.which("codes_export_resource")
    if path_bin:
        return path_bin

    script_dir = Path(__file__).resolve().parent
    candidates = [
        script_dir / "codes_export_resource",
        script_dir.parent / "bin" / "codes_export_resource",
    ]
    for candidate in candidates:
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)
    return None


def locate_codes_info() -> str | None:
    env_bin = os.getenv("ECCODES_INFO")
    if env_bin and Path(env_bin).is_file():
        return env_bin

    path_bin = shutil.which("codes_info")
    if path_bin:
        return path_bin

    script_dir = Path(__file__).resolve().parent
    candidates = [
        script_dir / "codes_info",
        script_dir.parent / "bin" / "codes_info",
    ]
    for candidate in candidates:
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)
    return None


def detect_default_definition_path_from_codes_info() -> str | None:
    codes_info = locate_codes_info()
    if not codes_info:
        return None

    result = subprocess.run(
        [codes_info],
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        return None

    for line in result.stdout.splitlines():
        m = DEFAULT_DEFINITION_PATH_RE.search(line)
        if m:
            return m.group(1)
    return None


def find_referenced_definition_paths(text: str) -> List[str]:
    # Keep this broad: template/include/reference statements consistently quote file paths.
    return uniq(match.group(1) for match in DEFINITION_FILE_RE.finditer(text))


def export_definition(exporter: str, resource_path: str, target_path: Path) -> bool:
    target_path.parent.mkdir(parents=True, exist_ok=True)
    cmd = [exporter, "-d", resource_path, str(target_path)]
    result = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    return result.returncode == 0


def discover_local_concept_centres(hint_roots: Iterable[Path], edition: str) -> List[str]:
    centres: List[str] = []
    for root in hint_roots:
        local_concepts = root / edition / "localConcepts"
        if not local_concepts.is_dir():
            continue
        for child in local_concepts.iterdir():
            if child.is_dir():
                centres.append(child.name)
    return uniq(centres)


def local_concept_seed_paths(hint_roots: Iterable[Path]) -> List[str]:
    seeds: List[str] = []
    concepts = ("paramId", "shortName", "name", "units")

    for centre in discover_local_concept_centres(hint_roots, "grib1"):
        for concept in concepts:
            seeds.append(f"grib1/localConcepts/{centre}/{concept}.def")

    for centre in discover_local_concept_centres(hint_roots, "grib2"):
        for concept in concepts:
            seeds.append(f"grib2/localConcepts/{centre}/{concept}.def")
            seeds.append(f"grib2/localConcepts/{centre}/{concept}.lte33.def")
            seeds.append(f"grib2/localConcepts/{centre}/{concept}.chemsplit.def")

    return uniq(seeds)


def materialize_memfs_definitions(exporter: str, hint_roots: Iterable[Path]) -> Path | None:
    temp_root = Path(tempfile.mkdtemp(prefix="codes_parameters_memfs_"))
    definitions_root = temp_root / "definitions"

    # Start from concept files used by this tool, then follow includes/references.
    queue: List[str] = [
        "grib1/paramId.def",
        "grib1/shortName.def",
        "grib1/name.def",
        "grib1/units.def",
        "grib2/paramId.def",
        "grib2/shortName.def",
        "grib2/name.def",
        "grib2/units.def",
        "grib2/paramId.lte33.def",
        "grib2/shortName.lte33.def",
        "grib2/name.lte33.def",
        "grib2/units.lte33.def",
        "grib2/paramId.chemsplit.def",
        "grib2/shortName.chemsplit.def",
        "grib2/name.chemsplit.def",
        "grib2/units.chemsplit.def",
    ]
    queue.extend(local_concept_seed_paths(hint_roots))
    queue = uniq(queue)
    seen: Set[str] = set()
    exported_any = False

    while queue:
        resource = queue.pop(0)
        if resource in seen:
            continue
        seen.add(resource)

        out_file = definitions_root / resource
        if not export_definition(exporter, resource, out_file):
            continue

        exported_any = True
        try:
            text = out_file.read_text(encoding="utf-8", errors="ignore")
        except OSError:
            continue

        for ref in find_referenced_definition_paths(text):
            if ref not in seen:
                queue.append(ref)

    if not exported_any:
        shutil.rmtree(temp_root, ignore_errors=True)
        return None
    return definitions_root


def compile_regex(pattern: str, option_name: str, case_sensitive: bool) -> Any:
    if pcre_regex is None:
        raise ValueError(
            f"{option_name} requires the Python 'regex' module for PCRE2-style matching"
        )

    flags = 0 if case_sensitive else pcre_regex.IGNORECASE
    try:
        return pcre_regex.compile(pattern, flags)
    except pcre_regex.error as exc:
        raise ValueError(f"Invalid pattern for {option_name}: {exc}") from exc


def build_field_matcher(
    wildcard: str | None,
    regex_text: str | None,
    option_name: str,
    case_sensitive: bool,
) -> FieldMatcher:
    if wildcard and regex_text:
        raise ValueError(f"Use either {option_name} or {option_name}-regex, not both")

    if regex_text is None:
        return FieldMatcher(wildcard=wildcard)

    compiled = compile_regex(regex_text, f"{option_name}-regex", case_sensitive)
    return FieldMatcher(regex_text=regex_text, regex_compiled=compiled)


def build_matchers(args: argparse.Namespace) -> Dict[str, FieldMatcher]:
    return {
        "name": build_field_matcher(args.name, args.name_regex, "--name", args.regex_case_sensitive),
        "shortName": build_field_matcher(
            args.shortName,
            args.shortName_regex,
            "--shortName",
            args.regex_case_sensitive,
        ),
        "paramId": build_field_matcher(args.paramId, args.paramId_regex, "--paramId", args.regex_case_sensitive),
        "units": build_field_matcher(args.units, args.units_regex, "--units", args.regex_case_sensitive),
    }


def matches_any(values: Iterable[str], matcher: FieldMatcher) -> bool:
    if matcher.wildcard is None and matcher.regex_compiled is None:
        return True

    if matcher.wildcard is not None:
        pattern_low = matcher.wildcard.lower()
        return any(fnmatch.fnmatch(v.lower(), pattern_low) for v in values)

    return any(matcher.regex_compiled.search(v) is not None for v in values)


def values_for(rec: Record, concept: str) -> List[str]:
    return rec.values.get(concept, [])


def parse_columns_arg(columns_text: str | None) -> List[str] | None:
    if columns_text is None:
        return None

    columns = [item.strip() for item in columns_text.split(",") if item.strip()]
    if not columns:
        raise ValueError("--columns must contain at least one column name")

    invalid = [item for item in columns if item not in VALID_COLUMNS]
    if invalid:
        valid = ", ".join(VALID_COLUMNS)
        raise ValueError(f"Invalid column name(s): {', '.join(invalid)}. Valid columns: {valid}")

    return uniq(columns)


def parse_attr_arg(attr_text: str | None) -> Dict[str, str] | None:
    if attr_text is None:
        return None

    pairs = [item.strip() for item in attr_text.split(",") if item.strip()]
    if not pairs:
        raise ValueError("--attr must contain at least one key=value pair")

    result: Dict[str, str] = {}
    for pair in pairs:
        if "=" not in pair:
            raise ValueError(f"Invalid --attr pair '{pair}'. Expected key=value")
        key, value = pair.split("=", 1)
        key = key.strip()
        value = value.strip()
        if not key:
            raise ValueError(f"Invalid --attr pair '{pair}'. Key cannot be empty")
        if key in result:
            raise ValueError(f"Duplicate key '{key}' in --attr")
        result[key] = value

    return result


def parse_nattrkey_arg(nattrkey_text: str | None) -> Set[str] | None:
    if nattrkey_text is None:
        return None

    keys = [item.strip() for item in nattrkey_text.split(",") if item.strip()]
    if not keys:
        raise ValueError("--nattrkey must contain at least one key")

    result: Set[str] = set()
    for key in keys:
        if not key:
            raise ValueError("Invalid --nattrkey: empty key")
        if "=" in key:
            raise ValueError(f"Invalid --nattrkey key '{key}'. Keys must not contain '='")
        if key in result:
            raise ValueError(f"Duplicate key '{key}' in --nattrkey")
        result.add(key)

    return result


def parse_nattr_arg(nattr_text: str | None) -> Dict[str, str] | None:
    if nattr_text is None:
        return None

    pairs = [item.strip() for item in nattr_text.split(",") if item.strip()]
    if not pairs:
        raise ValueError("--nattr must contain at least one key=value pair")

    result: Dict[str, str] = {}
    for pair in pairs:
        if "=" not in pair:
            raise ValueError(f"Invalid --nattr pair '{pair}'. Expected key=value")
        key, value = pair.split("=", 1)
        key = key.strip()
        value = value.strip()
        if not key:
            raise ValueError(f"Invalid --nattr pair '{pair}'. Key cannot be empty")
        if key in result:
            raise ValueError(f"Duplicate key '{key}' in --nattr")
        result[key] = value

    return result


def parse_scope_arg(scope_text: str | None) -> Set[str] | None:
    if scope_text is None:
        return None

    scopes = [item.strip() for item in scope_text.split(",") if item.strip()]
    if not scopes:
        raise ValueError("--scope must contain at least one scope")

    return set(scopes)


def validate_attr_keys(attr_filter: Dict[str, str] | None, records: Iterable[Record]) -> None:
    if attr_filter is None:
        return

    known_keys: Set[str] = set()
    for rec in records:
        known_keys.update(rec.attrs.keys())

    unknown = [key for key in attr_filter if key not in known_keys]
    if not unknown:
        return

    known_sorted = sorted(known_keys)
    errors: List[str] = []
    for key in unknown:
        suggestion = ""
        close = difflib.get_close_matches(key, known_sorted, n=1, cutoff=0.75)
        if close:
            suggestion = f" Did you mean '{close[0]}'?"
        errors.append(f"Key '{key}' seems to be misspelled.{suggestion}")

    raise ValueError(" ".join(errors))


def filter_records(
    records: Iterable[Record],
    args: argparse.Namespace,
    matchers: Dict[str, FieldMatcher],
    attr_filter: Dict[str, str] | None,
    nattrkey_filter: Set[str] | None,
    nattr_filter: Dict[str, str] | None,
    scope_filter: Set[str] | None,
) -> List[Record]:
    result = []
    for rec in records:
        if scope_filter is not None and rec.scope not in scope_filter:
            continue

        if args.is_mtg2_switch is not None:
            if rec.switch is None or rec.switch != args.is_mtg2_switch:
                continue

        if args.edition is not None and rec.edition != args.edition:
            continue

        if not matches_any(values_for(rec, "name"), matchers["name"]):
            continue
        if not matches_any(values_for(rec, "shortName"), matchers["shortName"]):
            continue
        if not matches_any(values_for(rec, "paramId"), matchers["paramId"]):
            continue
        if not matches_any(values_for(rec, "units"), matchers["units"]):
            continue

        if attr_filter is not None:
            if args.attr_strict:
                if rec.attrs != attr_filter:
                    continue
            else:
                if not all(rec.attrs.get(key) == value for key, value in attr_filter.items()):
                    continue

        if nattrkey_filter is not None and any(key in rec.attrs for key in nattrkey_filter):
            continue

        if nattr_filter is not None and any(rec.attrs.get(key) == value for key, value in nattr_filter.items()):
            continue

        result.append(rec)

    result.sort(key=lambda r: (r.edition, r.switch if r.switch is not None else -1, r.scope, values_for(r, "paramId")[:1]))
    return result


def format_values(values: List[str]) -> str:
    if not values:
        return "-"
    if len(values) == 1:
        return values[0]
    return "[" + ", ".join(values) + "]"


def merge_values(values: Iterable[List[str]]) -> List[str]:
    merged: List[str] = []
    for group in values:
        for item in group:
            if item not in merged:
                merged.append(item)
    return merged


def dedupe_display_records(records: List[Record], keep_attrs: bool) -> List[Record]:
    if keep_attrs:
        return records

    grouped: Dict[Tuple[int, int | None, str, str, str, str, str], List[Record]] = defaultdict(list)
    for rec in records:
        key = (
            rec.edition,
            rec.switch,
            rec.scope,
            format_values(values_for(rec, "paramId")),
            format_values(values_for(rec, "shortName")),
            format_values(values_for(rec, "name")),
            format_values(values_for(rec, "units")),
        )
        grouped[key].append(rec)

    deduped: List[Record] = []
    for group in grouped.values():
        if len(group) == 1:
            deduped.append(group[0])
            continue

        first = group[0]
        deduped.append(
            Record(
                edition=first.edition,
                switch=first.switch,
                scope=first.scope,
                attrs={},
                values={
                    "paramId": merge_values(values_for(r, "paramId") for r in group),
                    "shortName": merge_values(values_for(r, "shortName") for r in group),
                    "name": merge_values(values_for(r, "name") for r in group),
                    "units": merge_values(values_for(r, "units") for r in group),
                },
                sources=merge_values(r.sources for r in group),
            )
        )

    deduped.sort(key=lambda r: (r.edition, r.switch if r.switch is not None else -1, r.scope, values_for(r, "paramId")[:1]))
    return deduped


def print_records_line(
    records: List[Record],
    selected_columns: List[str] | None,
    show_encoding: bool,
    show_sources: bool,
) -> None:
    if selected_columns is not None:
        for rec in records:
            parts = [f"{column}={table_value(rec, column)}" for column in selected_columns]
            print(" ".join(parts))
        return

    for rec in records:
        if rec.switch is None:
            print(
                f"edition={rec.edition} scope={rec.scope} "
                f"paramId={format_values(values_for(rec, 'paramId'))} "
                f"shortName={format_values(values_for(rec, 'shortName'))} "
                f"name={format_values(values_for(rec, 'name'))} "
                f"units={format_values(values_for(rec, 'units'))}"
            )
        else:
            print(
                f"edition={rec.edition} is_mtg2_switch={rec.switch} scope={rec.scope} "
                f"paramId={format_values(values_for(rec, 'paramId'))} "
                f"shortName={format_values(values_for(rec, 'shortName'))} "
                f"name={format_values(values_for(rec, 'name'))} "
                f"units={format_values(values_for(rec, 'units'))}"
            )
        if show_encoding and rec.attrs:
            encoding_str = ", ".join(f"{k}={v}" for k, v in sorted(rec.attrs.items()))
            print(f"  encoding: {encoding_str}")
        if show_sources:
            print(f"  sources: {', '.join(sorted(rec.sources))}")


def truncate(text: str, width: int) -> str:
    if width < 4:
        return text[:width]
    if len(text) <= width:
        return text
    return text[: width - 3] + "..."


def table_value(rec: Record, key: str) -> str:
    if key == "edition":
        return str(rec.edition)
    if key == "is_mtg2_switch":
        return "-" if rec.switch is None else str(rec.switch)
    if key == "scope":
        return rec.scope
    if key == "paramId":
        return format_values(values_for(rec, "paramId"))
    if key == "shortName":
        return format_values(values_for(rec, "shortName"))
    if key == "name":
        return format_values(values_for(rec, "name"))
    if key == "units":
        return format_values(values_for(rec, "units"))
    if key == "encoding":
        return ", ".join(f"{k}={v}" for k, v in sorted(rec.attrs.items())) if rec.attrs else "-"
    if key == "sources":
        return ", ".join(sorted(rec.sources)) if rec.sources else "-"
    return "-"


def default_table_columns(records: List[Record], show_encoding: bool, show_sources: bool) -> List[Tuple[str, str]]:
    include_switch = any(rec.switch is not None for rec in records)
    columns: List[Tuple[str, str]] = [
        ("edition", "edition"),
        ("scope", "scope"),
        ("paramId", "paramId"),
        ("shortName", "shortName"),
        ("name", "name"),
        ("units", "units"),
    ]
    if include_switch:
        columns.insert(1, ("is_mtg2_switch", "is_mtg2_switch"))
    if show_encoding:
        columns.append(("encoding", "encoding"))
    if show_sources:
        columns.append(("sources", "sources"))
    return columns


def print_records_table(
    records: List[Record],
    selected_columns: List[str] | None,
    show_encoding: bool,
    show_sources: bool,
    truncate_cells: bool,
) -> None:
    columns = (
        [(column, column) for column in selected_columns]
        if selected_columns is not None
        else default_table_columns(records, show_encoding, show_sources)
    )

    rows: List[List[str]] = []
    for rec in records:
        rows.append([table_value(rec, key) for key, _ in columns])

    widths = [len(label) for _, label in columns]
    for row in rows:
        for i, cell in enumerate(row):
            widths[i] = max(widths[i], len(cell))

    if truncate_cells:
        max_width_by_col = {
            "edition": 7,
            "is_mtg2_switch": 14,
            "scope": 28,
            "paramId": 12,
            "shortName": 16,
            "name": 48,
            "units": 20,
            "encoding": 60,
            "sources": 60,
        }
        for i, (key, _) in enumerate(columns):
            widths[i] = min(widths[i], max_width_by_col.get(key, widths[i]))

        terminal_width = shutil.get_terminal_size((140, 24)).columns
        total_width = sum(widths) + (3 * (len(widths) - 1))
        if total_width > terminal_width:
            for shrink_key in ("name", "scope", "encoding", "sources"):
                if total_width <= terminal_width:
                    break
                for i, (key, _) in enumerate(columns):
                    if key == shrink_key and widths[i] > 12:
                        delta = min(widths[i] - 12, total_width - terminal_width)
                        widths[i] -= delta
                        total_width -= delta
                        if total_width <= terminal_width:
                            break

    header = " | ".join(label.ljust(widths[i]) for i, (_, label) in enumerate(columns))
    divider = "-+-".join("-" * widths[i] for i in range(len(widths)))
    print(header)
    print(divider)

    for row in rows:
        if truncate_cells:
            print(" | ".join(truncate(cell, widths[i]).ljust(widths[i]) for i, cell in enumerate(row)))
        else:
            print(" | ".join(cell.ljust(widths[i]) for i, cell in enumerate(row)))


def make_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="codes_parameters",
        description="Query parameter definitions in ecCodes concept files.",
        allow_abbrev=False,
    )
    parser.add_argument(
        "--definitions-root",
        default=None,
        help=(
            "Definitions root directory. Accepts multiple paths separated by path separator. "
            "If omitted, resolution order is: --definitions-root; "
            "ECCODES_EXTRA_DEFINITION_PATH (plus aliases ECCODES_EXTRA_DEFINITIONS and "
            "ECCODES_EXTRA_DEFINITONS); ECCODES_DEFINITION_PATH; then defaults "
            "<prefix>/share/eccodes/definitions, <prefix>/definitions, "
            "<prefix>/share/definitions, <prefix>/../share/eccodes/definitions, ./definitions. "
            "If none exist and no explicit roots were provided, MEMFS is tried automatically."
        ),
    )
    parser.add_argument(
        "--debug-path-resolution",
        action="store_true",
        help="Print resolved definitions path candidates and selected roots to stderr",
    )
    parser.add_argument(
        "--columns",
        help=(
            "Comma-separated list of output columns to show. "
            "Valid columns: edition,is_mtg2_switch,scope,paramId,shortName,name,units,encoding,sources"
        ),
    )
    parser.add_argument(
        "--scope",
        help="Comma-separated list of exact scopes to include, e.g. 'grib2,grib2/localConcepts/ecmf'",
    )
    parser.add_argument("--name", help="Wildcard pattern for name, e.g. '*precipitation*'")
    parser.add_argument("--name-regex", help="PCRE2-style regex for name")
    parser.add_argument("--shortName", help="Wildcard pattern for shortName, e.g. '10m*'")
    parser.add_argument("--shortName-regex", help="PCRE2-style regex for shortName")
    parser.add_argument("--paramId", help="Wildcard pattern for paramId")
    parser.add_argument("--paramId-regex", help="PCRE2-style regex for paramId")
    parser.add_argument("--units", help="Wildcard pattern for units")
    parser.add_argument("--units-regex", help="PCRE2-style regex for units")
    parser.add_argument(
        "--attr",
        help="Filter by attribute key/value pairs as key=value,key=value. Non-strict mode matches entries containing at least these pairs",
    )
    parser.add_argument(
        "--attr-strict",
        action="store_true",
        help="With --attr, require an exact attribute set match (same keys and values)",
    )
    parser.add_argument(
        "--nattrkey",
        help="Exclude parameters with specific attribute keys (comma-separated list)",
    )
    parser.add_argument(
        "--nattr",
        help="Exclude parameters with specific attribute key/value pairs as key=value,key=value",
    )
    parser.add_argument(
        "--regex-case-sensitive",
        action="store_true",
        help="Make regex searches case-sensitive. By default regex searches are case-insensitive",
    )
    parser.add_argument(
        "--is_mtg2_switch",
        type=int,
        choices=[0, 1, 2],
        help="Restrict GRIB2 to lte33=0, def=1, chemsplit=2",
    )
    parser.add_argument(
        "--edition",
        type=int,
        choices=[1, 2],
        help="Restrict to GRIB edition 1 or 2",
    )
    parser.add_argument(
        "--show-encoding",
        action="store_true",
        help="Show the GRIB encoding constraints (same key/value conditions)",
    )
    parser.add_argument(
        "--show-sources",
        action="store_true",
        help="Show source definition files contributing to each result",
    )
    parser.add_argument(
        "--format",
        choices=["line", "table"],
        default="line",
        help="Output format: line (default) or table",
    )
    parser.add_argument(
        "--no-truncate",
        action="store_true",
        help="With --format table, do not truncate cells to terminal width",
    )
    return parser


def main() -> int:
    parser = make_parser()
    if len(sys.argv) == 1:
        parser.print_help()
        return 0
    args = parser.parse_args()

    try:
        matchers = build_matchers(args)
        selected_columns = parse_columns_arg(args.columns)
        attr_filter = parse_attr_arg(args.attr)
        nattrkey_filter = parse_nattrkey_arg(args.nattrkey)
        nattr_filter = parse_nattr_arg(args.nattr)
        scope_filter = parse_scope_arg(args.scope)
    except ValueError as exc:
        parser.error(str(exc))

    if args.attr_strict and attr_filter is None:
        parser.error("--attr-strict requires --attr")

    explicit_roots = explicit_roots_from_args_env(args)
    candidates = candidate_roots(args)
    filesystem_roots, memfs_roots, warnings = resolve_roots(args)
    fallback_filesystem_roots = list(filesystem_roots)
    records_by_key: Dict[RecordKey, Record] = {}
    detected_default_definition_path = None
    auto_memfs = False
    used_filesystem_backend = False
    used_memfs_backend = False

    # When no explicit roots are provided, mirror the runtime default path used
    # by other ecCodes binaries (as reported by codes_info).
    if not explicit_roots:
        detected_default_definition_path = detect_default_definition_path_from_codes_info()
        if detected_default_definition_path and detected_default_definition_path.startswith("/MEMFS"):
            memfs_roots = uniq([detected_default_definition_path] + memfs_roots)
            # Keep behavior consistent with codes_info default path semantics.
            filesystem_roots = []

    # Mirror typical ecCodes runtime behavior: if defaults do not resolve to
    # real directories, automatically try MEMFS-backed definitions.
    if not explicit_roots and not filesystem_roots and not memfs_roots:
        memfs_roots.append("/MEMFS/definitions")
        auto_memfs = True

    if args.debug_path_resolution:
        print("DEBUG: explicit roots:", file=sys.stderr)
        if explicit_roots:
            for root in explicit_roots:
                print(f"DEBUG:   {root}", file=sys.stderr)
        else:
            print("DEBUG:   <none>", file=sys.stderr)

        print("DEBUG: candidate roots:", file=sys.stderr)
        for root in candidates:
            print(f"DEBUG:   {root}", file=sys.stderr)

        print("DEBUG: filesystem roots:", file=sys.stderr)
        if filesystem_roots:
            for root in filesystem_roots:
                print(f"DEBUG:   {root}", file=sys.stderr)
        else:
            print("DEBUG:   <none>", file=sys.stderr)

        print("DEBUG: memfs roots:", file=sys.stderr)
        if memfs_roots:
            for root in memfs_roots:
                print(f"DEBUG:   {root}", file=sys.stderr)
        else:
            print("DEBUG:   <none>", file=sys.stderr)
        print(
            "DEBUG: codes_info default definitions path: "
            f"{detected_default_definition_path or '<unavailable>'}",
            file=sys.stderr,
        )
        if auto_memfs:
            print("DEBUG: auto memfs fallback enabled", file=sys.stderr)

    for warning in warnings:
        print(f"WARNING: {warning}", file=sys.stderr)

    for root in filesystem_roots:
        used_filesystem_backend = True
        merge_records(records_by_key, scan_definitions(root))

    if memfs_roots:
        exporter = locate_codes_export_resource()
        if args.debug_path_resolution:
            print(f"DEBUG: codes_export_resource={exporter or '<not found>'}", file=sys.stderr)
        if not exporter:
            print(
                "WARNING: MEMFS path requested but codes_export_resource was not found. "
                "Skipping MEMFS definitions.",
                file=sys.stderr,
            )
        else:
            memfs_root = materialize_memfs_definitions(exporter, fallback_filesystem_roots)
            if memfs_root is None:
                print("WARNING: Failed to materialize definitions from MEMFS.", file=sys.stderr)
                # Use discovered filesystem roots as a last resort if MEMFS
                # export fails at runtime.
                if fallback_filesystem_roots:
                    used_filesystem_backend = True
                    for root in fallback_filesystem_roots:
                        merge_records(records_by_key, scan_definitions(root))
            else:
                used_memfs_backend = True
                merge_records(records_by_key, scan_definitions(memfs_root))

    if used_memfs_backend and used_filesystem_backend:
        effective_backend = "mixed"
    elif used_memfs_backend:
        effective_backend = "memfs"
    elif used_filesystem_backend:
        effective_backend = "filesystem"
    else:
        effective_backend = "none"

    if args.debug_path_resolution:
        print(f"DEBUG: effective backend: {effective_backend}", file=sys.stderr)

    if not records_by_key:
        parser.error(
            "No valid definitions roots were found. Provide --definitions-root, "
            "set ECCODES_DEFINITION_PATH/ECCODES_EXTRA_DEFINITION_PATH, "
            "or ensure MEMFS export is available."
        )

    records = list(records_by_key.values())
    try:
        validate_attr_keys(attr_filter, records)
    except ValueError as exc:
        print(f"{parser.prog}: error: {exc}", file=sys.stderr)
        return 2

    filtered = filter_records(records, args, matchers, attr_filter, nattrkey_filter, nattr_filter, scope_filter)
    keep_attrs = (
        args.show_encoding
        or attr_filter is not None
        or (selected_columns is not None and "encoding" in selected_columns)
    )
    filtered = dedupe_display_records(filtered, keep_attrs=keep_attrs)

    if not filtered:
        print("No matching parameters found.")
        return 1

    try:
        if args.format == "table":
            print_records_table(
                filtered,
                selected_columns,
                show_encoding=args.show_encoding,
                show_sources=args.show_sources,
                truncate_cells=(not args.no_truncate),
            )
        else:
            print_records_line(
                filtered,
                selected_columns,
                show_encoding=args.show_encoding,
                show_sources=args.show_sources,
            )
    except BrokenPipeError:
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())

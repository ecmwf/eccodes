{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ci",
      "cacheVariables": {
        "ENABLE_EXTRA_TESTS": "ON",
        "ENABLE_ECCODES_OMP_THREADS": "ON"
      }
    },
    {
      "name": "eckit-geo",
      "inherits": "ci",
      "cacheVariables": {
        "ENABLE_GEOGRAPHY": "ON",
        "ENABLE_ECKIT_GEO": "ON"
      }
    }
  ]
}

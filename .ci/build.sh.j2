{% extends "ci-infrastructure/cmake-runner.sh.j2" %}
{% block cmake_args %}
{% if not fc %}
  -DENABLE_FORTRAN=OFF \
{% endif %}
{% endblock %}
{% block test %}
# The tests run before install, so point the C++ tests at the build tree.
export ECCODES_DEFINITION_PATH="$build/share/eccodes/definitions"
export ECCODES_SAMPLES_PATH="$build/share/eccodes/samples"
{% if options == "eckit-geo" %}
cd "$CI_SOURCE_DIR"
failed=0
for preset in eckit-geo-0 eckit-geo-1; do
  ctest --preset "$preset" --test-dir "$build" -j "$jobs" || failed=1
done
[ "$failed" -eq 0 ]
{% else %}
ctest --test-dir "$build" --output-on-failure -j "$jobs"
{% endif %}
{% endblock %}
